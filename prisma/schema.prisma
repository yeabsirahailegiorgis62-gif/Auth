generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  COMMENTER
  VIEWER
}

enum AiProvider {
  OPENAI
  ANTHROPIC
  LOCAL
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum NotificationType {
  SYSTEM
  MENTION
  DOCUMENT_UPDATE
  WORKSPACE_INVITE
  COMMENT
}

model User {
  id                          Int       @id @default(autoincrement())
  name                        String
  email                       String    @unique
  passwordHash                String?
  googleId                    String?
  avatarUrl                   String?
  bio                         String?
  failedLoginAttempts         Int       @default(0)
  lockedUntil                 DateTime?
  isVerified                  Boolean   @default(false)
  verificationTokenHash       String?   @unique
  verificationTokenExpiresAt  DateTime?
  passwordResetTokenHash      String?   @unique
  passwordResetTokenExpiresAt DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  deletedAt                   DateTime?

  sessions        Session[]
  documents       Document[]      @relation("UserOwnedDocuments")
  shares          DocumentShare[]
  invitedShares   DocumentShare[] @relation("UserInvitedShares")
  revisions       Revision[]
  createdThreads  CommentThread[] @relation("UserCreatedThreads")
  resolvedThreads CommentThread[] @relation("UserResolvedThreads")
  comments        Comment[]
  favorites       Favorite[]
  activities      ActivityLog[]
  notifications   Notification[]
  aiUsageLogs     AiUsageLog[]
  aiHistory       AiHistory[]

  ownedWorkspaces  Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers WorkspaceMember[]
  invitationsSent  Invitation[]      @relation("InvitationSender")

  @@index([deletedAt])
}

model Session {
  id               Int      @id @default(autoincrement())
  userId           Int
  refreshTokenHash String   @unique
  device           String?
  ipAddress        String?
  createdAt        DateTime @default(now())
  expiresAt        DateTime
  lastActiveAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastActiveAt])
}

model Workspace {
  id          String    @id @default(uuid())
  name        String
  description String?
  logoUrl     String?
  color       String?   @default("#3b82f6") // Default blue
  ownerId     Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  owner       User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     WorkspaceMember[]
  folders     Folder[]
  documents   Document[]
  tags        Tag[]
  invitations Invitation[]
  aiConfig    WorkspaceAiConfig?
  aiUsageLogs AiUsageLog[]

  @@index([ownerId])
  @@index([deletedAt])
}

model WorkspaceMember {
  id          String   @id @default(uuid())
  workspaceId String
  userId      Int
  role        Role     @default(VIEWER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId, role])
  @@index([userId, workspaceId, role])
}

model Invitation {
  id          String           @id @default(uuid())
  workspaceId String
  email       String
  role        Role             @default(VIEWER)
  status      InvitationStatus @default(PENDING)
  tokenHash   String           @unique
  invitedById Int
  expiresAt   DateTime
  createdAt   DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
}

model Folder {
  id          String    @id @default(uuid())
  name        String
  workspaceId String
  parentId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    Folder?    @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]   @relation("FolderHierarchy")
  documents Document[]

  @@index([workspaceId, parentId, deletedAt])
}

model Tag {
  id          String   @id @default(uuid())
  name        String
  color       String   @default("#e5e7eb")
  workspaceId String
  createdAt   DateTime @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documents DocumentTag[]

  @@unique([workspaceId, name])
}

model DocumentTag {
  id         String   @id @default(uuid())
  documentId String
  tagId      String
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([documentId, tagId])
  @@index([documentId])
  @@index([tagId])
}

model Document {
  id           String    @id @default(uuid())
  title        String    @default("Untitled Document")
  content      String    @default("")
  yjsState     Bytes?
  ownerId      Int
  workspaceId  String?
  folderId     String?
  isArchived   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  lastOpenedAt DateTime  @default(now())
  version      Int       @default(1)

  owner          User            @relation("UserOwnedDocuments", fields: [ownerId], references: [id], onDelete: Cascade)
  workspace      Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder         Folder?         @relation(fields: [folderId], references: [id], onDelete: SetNull)
  shares         DocumentShare[]
  revisions      Revision[]
  commentThreads CommentThread[]
  favorites      Favorite[]
  activities     ActivityLog[]
  notifications  Notification[]
  tags           DocumentTag[]
  aiHistory      AiHistory[]

  @@index([workspaceId, folderId, deletedAt])
  @@index([ownerId])
  @@index([isArchived])
  @@index([lastOpenedAt])
  @@index([updatedAt])
}

model DocumentShare {
  id          String   @id @default(uuid())
  documentId  String
  userId      Int
  role        Role     @default(VIEWER)
  invitedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User?    @relation("UserInvitedShares", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([documentId, userId])
  @@index([userId])
  @@index([documentId])
}

model Revision {
  id         String   @id @default(uuid())
  documentId String
  authorId   Int
  content    String
  version    Int      @default(1)
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model CommentThread {
  id           String    @id @default(uuid())
  documentId   String
  createdBy    Int
  selectedText String    @default("")
  fromPos      Int?
  toPos        Int?
  resolved     Boolean   @default(false)
  resolvedById Int?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  document Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  creator  User      @relation("UserCreatedThreads", fields: [createdBy], references: [id], onDelete: Cascade)
  resolver User?     @relation("UserResolvedThreads", fields: [resolvedById], references: [id], onDelete: SetNull)
  comments Comment[]

  @@index([documentId, resolved])
  @@index([createdBy])
}

model Comment {
  id        String   @id @default(uuid())
  threadId  String
  authorId  Int
  content   String
  edited    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  thread CommentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([authorId])
}

model Favorite {
  id         String   @id @default(uuid())
  userId     Int
  documentId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([userId, documentId])
  @@index([userId])
  @@index([documentId])
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      Int
  workspaceId String?
  documentId  String?
  entityType  String?
  action      String
  metadata    String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([userId])
  @@index([documentId])
}

model Notification {
  id          String           @id @default(uuid())
  userId      Int
  workspaceId String?
  documentId  String?
  type        NotificationType @default(SYSTEM)
  message     String
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([workspaceId])
  @@index([read])
  @@index([createdAt])
}

model WorkspaceAiConfig {
  id          String     @id @default(uuid())
  workspaceId String     @unique
  provider    AiProvider @default(OPENAI)
  apiKey      String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model AiUsageLog {
  id          String   @id @default(uuid())
  workspaceId String
  userId      Int
  tokensUsed  Int      @default(0)
  action      String   @default("unknown")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([userId])
}

model AiHistory {
  id          String   @id @default(uuid())
  userId      Int
  documentId  String
  prompt      String
  response    String
  action      String
  createdAt   DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([documentId])
}
